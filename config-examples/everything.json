{
  "sync": {
    "mode": "auto"
  },
  "ledger": {
    "enabled": true
  },
  "extractors": {
    "utxo": {
      "enabled": true,
      "consumed_by_tx_id": true,
      "tx_in": true,
      "strategy": "archive"
    },
    "multi_asset": true,
    "metadata": true,
    "stake_delegation": true,
    "stake_delegation_ledger": true,
    "pool": true,
    "pool_stats": true,
    "scripts_datums": true,
    "governance": true,
    "off_chain_votes": true,
    "off_chain_pools": true,
    "cbor": true,
    "epoch_sync_stats": true,
    "epoch_boundary": true,
    "current_state": true,
    "epoch": true
  },
  "metrics": {
    "prometheus_port": 8080
  },
  "logging": {
    "level": "info",
    "format": "text"
  }
}
