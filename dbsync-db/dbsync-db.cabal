cabal-version: 3.6
name:          dbsync-db
version:       0.1.0.0
synopsis:      PostgreSQL schema, loader-stream encoding, and DB interface for dbsync
description:   Shared database layer used by both dbsync (write) and
               dbsync-smash (read). Owns schema types, CREATE TABLE DDL
               generation, loader-stream wire-format encoding, and the
               connection/writer interface.
license:       Apache-2.0
author:        IOHK Engineering Team
maintainer:    operations@iohk.io
category:      Cryptocurrency
build-type:    Simple

-- Schema migration files; packaged so they can be embedded at build time.
extra-source-files: migrations/*.sql

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wpartial-fields
    -Widentities
    -Wunused-packages
    -Werror

common defaults
  default-language:   GHC2021
  default-extensions:
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    DerivingStrategies
    GeneralizedNewtypeDeriving
    LambdaCase

library
  import:         warnings, defaults
  hs-source-dirs: src
  exposed-modules:
    DbSync.Db.Types
    DbSync.Db.Schema.Entity
    DbSync.Db.Schema.Ids
    DbSync.Db.Schema.Types
    DbSync.Db.Schema.Core
    DbSync.Db.Schema.Address
    DbSync.Db.Schema.UTxO
    DbSync.Db.Schema.Metadata
    DbSync.Db.Schema.MultiAsset
    DbSync.Db.Schema.StakeDelegation
    DbSync.Db.Schema.Pool
    DbSync.Db.Schema.CBOR
    DbSync.Db.Schema.ScriptsDatums
    DbSync.Db.Schema.Governance
    DbSync.Db.Schema.EpochSyncStats
    DbSync.Db.Schema.AdaPots
    DbSync.Db.Schema.EpochBoundary
    DbSync.Db.Schema.OffChainPool
    DbSync.Db.Schema.OffChainVote
    DbSync.Db.Schema.EpochView
    DbSync.Db.Schema.SyncState
    DbSync.Db.Schema.EpochParamPending
    DbSync.Db.Schema.Generate
    DbSync.Db.Schema.Init
    DbSync.Db.Schema.Migration
    DbSync.Db.Schema.Migration.Diff
    DbSync.Db.Schema.Migration.Files
    DbSync.Db.Schema.Migration.Render
    DbSync.Db.Sql
    DbSync.Db.Sql.Refs
    DbSync.Db.Statement.CBOR
    DbSync.Db.Statement.Common
    DbSync.Db.Statement.Constraints
    DbSync.Db.Statement.Core
    DbSync.Db.Statement.EpochBoundary
    DbSync.Db.Statement.EpochSyncStats
    DbSync.Db.Statement.EpochView
    DbSync.Db.Statement.Governance
    DbSync.Db.Statement.IdAllocator
    DbSync.Db.Statement.Indexes
    DbSync.Db.Statement.Loader
    DbSync.Db.Statement.Metadata
    DbSync.Db.Statement.MultiAsset
    DbSync.Db.Statement.Pool
    DbSync.Db.Statement.PoolStats
    DbSync.Db.Statement.ScriptsDatums
    DbSync.Db.Statement.Sequences
    DbSync.Db.Statement.StakeDelegation
    DbSync.Db.Statement.StakeDelegationLedger
    DbSync.Db.Statement.SyncState
    DbSync.Db.Statement.Transaction
    DbSync.Db.Statement.Tuning
    DbSync.Db.Statement.UTxO
    DbSync.Db.Statement.Worker.Backfill
    DbSync.Db.Statement.Worker.ConsumedBy
    DbSync.Db.Statement.Worker.EpochAnchor
    DbSync.Db.Statement.Worker.EpochParamPending
    DbSync.Db.Statement.Worker.OffChainPool
    DbSync.Db.Statement.Worker.OffChainVote
    DbSync.Db.Statement.Worker.RedeemerScriptHash
    DbSync.Db.Statement.Worker.Resolve
    DbSync.Db.Statement.Worker.Resume
    DbSync.Db.Statement.Worker.Rollback
    DbSync.Db.Loader.Encoder
    DbSync.Util.Bech32
    DbSync.Util.DedupHash
  build-depends:
      base                  >= 4.14 && < 5
    , cardano-prelude

    -- Crypto / encoding
    , base58-bytestring
    , bech32
    , cardano-crypto-class

    -- Data
    , bytestring
    , file-embed
    , scientific
    , text
    , time
    , wide-word

    -- Database (control-plane queries via hasql; the COPY-streaming
    -- path lives in `dbsync` and uses postgresql-libpq directly).
    , hasql

    -- System
    , process
