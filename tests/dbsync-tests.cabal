-- ---------------------------------------------------------------------------
-- Database comparison CLI
-- ---------------------------------------------------------------------------
--
-- Standalone tool: everything (CLI, connection layer, schema coverage,
-- row counts, spot checks) lives under @compare/@.
executable dbsync-compare
  import:         warnings, defaults
  hs-source-dirs: compare
  main-is:        Main.hs
  ghc-options:    -threaded
  other-modules:
    DbSync.Compare.Check
    DbSync.Compare.Connect
    DbSync.Compare.FkGraph
    DbSync.Compare.Introspect
    DbSync.Compare.Normalize
    DbSync.Compare.Options
    DbSync.Compare.Report
    DbSync.Compare.RowCompare
    DbSync.Compare.RowCounts
    DbSync.Compare.Schema
    DbSync.Compare.SchemaCoverage
    DbSync.Compare.SpotCheck
    DbSync.Compare.Structure
  build-depends:
      base
    , cardano-prelude
    , containers
    , dbsync
    , dbsync-db
    , hasql
    , optparse-applicative
    , random
    , text
