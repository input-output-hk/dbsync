packages:
  dbsync-db
  dbsync
  dbsync-smash
  tests
  tests/dbsync-mock

-- ---------------------------------------------------------------------------
-- Package flags
-- ---------------------------------------------------------------------------

-- Local packages build with full optimisation. cabal's default is
-- -O1; the per-row encoder / parser / extractor loops benefit from
-- -O2's SpecConstr and deeper unboxing. Note: all measurements in
-- measurements/ taken before 2026-06-12 are of -O1 builds.
package dbsync
  optimization: 2
  -- Embed the IPE info-table map so throwIO collects a real multi-frame
  -- backtrace at the throw site (rendered by DbSync.Error.Render). Costs
  -- binary size only; nothing on the happy path.
  ghc-options: -finfo-table-map

package dbsync-db
  optimization: 2
  ghc-options: -finfo-table-map

package postgresql-libpq
  flags: +use-pkg-config

package cryptonite
  flags: -support_rdrand

package text
  flags: -simdutf

package snap-server
  flags: -openssl

package cardano-node
  flags: -systemd

-- 'blockio' wraps the system-level block I/O primitives used by the
-- LSM-tree backend. It has two implementations:
--
--   * Default (no flag): uses 'io_uring' on Linux for batched,
--     asynchronous I/O. Faster — see LEDGER-PERF.md §3.2 / §4.2 for
--     why this matters: the 'lsmRead' + 'lsmDuplicate' calls in
--     'tickThenReapplyCheckHash' are on the critical path of every
--     ledger apply, and Mary/Alonzo apply times scale with their
--     latency.
--   * '+serialblockio': falls back to a synchronous, syscall-per-op
--     implementation. Portable; the only choice on macOS / Windows /
--     other non-Linux targets where 'io_uring' is unavailable.
--
-- Linux operators need 'liburing-dev' (Ubuntu) / 'liburing-devel'
-- (Fedora) installed before building. Available on any kernel
-- ≥ 5.1, which is every distro currently in support.
--
-- macOS / other developers: nothing to do — the conditional below
-- picks the serial fallback automatically.
if !os(linux)
  package blockio
    flags: +serialblockio

-- ---------------------------------------------------------------------------
-- Constraints
-- ---------------------------------------------------------------------------

constraints:
  , text < 2.1.2
  , any.proto-lens-setup >= 0.4.0.10
  , validation < 1.2

-- Allow-newer clauses needed by LSM/LedgerDB V2 transitive deps, plus the
-- GHC 9.14 boot-library upper bounds relaxed so the pinned snapshot solves
-- against base-4.22 and its bundled boot packages.
allow-newer:
  , cardano-api:plutus-core
  , resource-registry:nothunks
  , Unique:hashable
  , *:base
  , *:ghc-prim
  , *:ghc-bignum
  , *:ghc-internal
  , *:ghc
  , *:ghc-boot
  , *:ghc-boot-th
  , *:ghc-heap
  , *:integer-gmp
  , *:template-haskell
  , *:array
  , *:binary
  , *:bytestring
  , *:containers
  , *:deepseq
  , *:directory
  , *:exceptions
  , *:filepath
  , *:file-io
  , *:mtl
  , *:os-string
  , *:parsec
  , *:pretty
  , *:process
  , *:semaphore-compat
  , *:stm
  , *:text
  , *:time
  , *:transformers
  , *:unix
  , *:Cabal
  , *:Cabal-syntax

-- ---------------------------------------------------------------------------
-- Tests
-- ---------------------------------------------------------------------------

tests: True
test-show-details: direct
write-ghc-environment-files: always

-- ---------------------------------------------------------------------------
-- Source repository packages
-- ---------------------------------------------------------------------------
--
-- cardano-node is not published to CHaP as a library, so it is pinned to the
-- upstream release tag. ouroboros-consensus (with its lsm / cardano / protocol
-- / diffusion sublibraries), ouroboros-network, lsm-tree and blockio all
-- resolve from CHaP / Hackage via the index-state above.

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-node
  tag: 11.0.1
  subdir:
    cardano-node
    trace-forward
    trace-resources
