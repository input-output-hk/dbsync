-- ---------------------------------------------------------------------------
-- Executable
-- ---------------------------------------------------------------------------
executable dbsync
  import:         warnings, defaults
  hs-source-dirs: app
  main-is:        Main.hs
  -- Baked-in RTS defaults. Overridable at runtime because of -rtsopts:
  --   dbsync ... +RTS -N4 -A16m -RTS
  --
  --   -A64m   per-capability nursery. Loader-stream encoders allocate
  --           ~3 GB/s of short-lived ByteStrings; a large nursery
  --           lets them die young instead of being promoted.
  --   -N6     parallel capabilities. Operators on the 4-core target
  --           override with +RTS -N4 -RTS at runtime.
  --   -T      enable GHC.Stats so the prometheus endpoint can
  --           publish GC numbers.
  --   -I0     disable idle-time GC. Prevents the runtime triggering
  --           a Gen-1 collection during chain-tip following whenever
  --           the program goes briefly quiet between blocks; that
  --           GC interrupts the otherwise-idle moment for no benefit
  --           (the next block's allocations would trigger one anyway).
  --   --disable-delayed-os-memory-return
  --           run madvise() immediately after each major GC rather
  --           than batching it. Without this the RTS holds onto
  --           megablocks past the high-water mark of a transient
  --           allocation peak, ratcheting RSS up to several times
  --           the steady-state heap as the chain progresses.
  ghc-options:
    -threaded -rtsopts
    "-with-rtsopts=-A64m -N6 -T -I0 --disable-delayed-os-memory-return"
  build-depends:
      dbsync
    , cardano-prelude
    , contra-tracer
    , filepath
